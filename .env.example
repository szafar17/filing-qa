# Copy to .env (which is gitignored) and fill in. Never commit .env.

# OpenAI key for embeddings (text-embedding-3-small), answers, and the faithfulness judge.
OPENAI_API_KEY=

# SEC EDGAR fair-access policy requires a descriptive User-Agent with contact info,
# for example: "Jane Doe jane.doe@yourdomain.com". Downloads refuse to start if unset.
SEC_USER_AGENT=

# Postgres started by `docker compose up -d` (see docker-compose.yml).
FILINGQA_DATABASE_URL=postgresql://filingqa:filingqa@localhost:5433/filingqa

# Optional: initials or handle recorded on golden-set items you verify with `make label`.
FILINGQA_REVIEWER=
